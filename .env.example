# =============================================================================
# LLM Cost Optimizer — Environment Configuration
# =============================================================================

# Authentication Method: "vertex_ai" (recommended) or "api_key" (legacy)
AUTH_METHOD=vertex_ai

# =============================================================================
# Vertex AI Configuration (when AUTH_METHOD = vertex_ai)
# =============================================================================
# Path to your Google Cloud service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Your Google Cloud project ID (from the JSON file or Cloud Console)
GCP_PROJECT_ID=your-gcp-project-id

# Google Cloud region
GCP_LOCATION=us-central1

# =============================================================================
# Legacy Gemini API Key (when AUTH_METHOD = api_key)
# =============================================================================
# GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# Model Configuration
# =============================================================================
EMBEDDING_MODEL=gemini-embedding-001
LLM_MODEL=gemini-2.5-flash

# =============================================================================
# Cache Configuration
# =============================================================================
MAX_CACHE_SIZE=50
OPTIMIZATION_INTERVAL=50

# =============================================================================
# Simulation Mode — each controls a specific pipeline stage
# "true" = local/fake (no API call)   |   "false" = real Vertex AI call
# =============================================================================
SIMULATE_LLM=true          # Stage 5: LLM response generation
SIMULATE_EMBEDDINGS=true    # Stage 2: Semantic cache embeddings
SIMULATE_SHORTENER=true     # Stage 1: Prompt shortening via LLM
